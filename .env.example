# Copy to .env and fill in your values, then `set -a; . ./.env; set +a`.
# The manifests under build/k8s/ and build/aws/ and examples/strands-chat/ are
# templates that reference these; render them with envsubst before applying, e.g.
#   envsubst < build/k8s/provider-deploy.yaml | kubectl apply -f -

export AWS_REGION=us-east-2
export AWS_ACCOUNT_ID=111122223333
export CLUSTER=my-eks-cluster
# Convention: microvm-sandbox-shim-<account>-<region>
export ARTIFACT_BUCKET=microvm-sandbox-shim-111122223333-us-east-2
